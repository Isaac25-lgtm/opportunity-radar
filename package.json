{
  "name": "opportunity-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Opportunity Radar: profiles, CV builder and explainable opportunity matching for Uganda and East Africa, on Cloudflare Workers.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply opportunity-radar-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply opportunity-radar-db --remote",
    "env:check": "node scripts/check-env.mjs",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "docx": "9.5.1",
    "hono": "4.13.16",
    "lucide-react": "0.511.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@eslint/js": "9.28.0",
    "@playwright/test": "1.65.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.1",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "10.4.21",
    "concurrently": "9.1.2",
    "eslint": "9.28.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.2.0",
    "postcss": "8.5.32",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "typescript-eslint": "8.33.1",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
