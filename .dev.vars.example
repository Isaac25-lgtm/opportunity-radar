# Copy to .dev.vars for local development. Never commit real values.
ENVIRONMENT=development
APP_URL=http://localhost:5173
ADMIN_EMAILS=you@example.com
# Email: none | sendgrid | resend
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
# AI: none | python. 'python' uses the AI service in ai-service/ (see its README); 'none' uses the
# built-in, non-AI tools. The Claude API key lives in the AI service, not here.
AI_PROVIDER=none
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
# Payments: none | mock | pesapal   ('mock' is refused when ENVIRONMENT=production)
PAYMENT_PROVIDER=mock
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_IPN_SECRET=
# ReliefWeb requires a pre-approved appname
RELIEFWEB_APPNAME=
