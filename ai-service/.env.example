# Copy to .env for local runs. Never commit real values.
# Claude credentials (read by the Anthropic SDK).
ANTHROPIC_API_KEY=
# Shared secret. Set the same value as AI_SERVICE_TOKEN on the Cloudflare Worker.
AI_SERVICE_TOKEN=
# Optional: model and effort (defaults: claude-opus-5-5, medium).
AI_MODEL=
AI_EFFORT=
